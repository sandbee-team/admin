{
  "name": "sandbee-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "bootstrap": "node --env-file=.env scripts/bootstrap.js",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "playwright test",
    "format": "prettier --write backend frontend shared scripts test *.json *.mjs",
    "backup": "node --env-file=.env scripts/recovery.js backup",
    "restore": "node --env-file=.env scripts/recovery.js restore",
    "reset-totp": "node --env-file=.env scripts/recovery.js reset-totp"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-select": "2.3.7",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "lru-cache": "11.5.3",
    "lucide-react": "1.47.0",
    "mongodb": "7.6.0",
    "nodemailer": "10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "mongodb-memory-server": "11.2.0",
    "prettier": "3.9.8",
    "vite": "8.3.0"
  }
}
