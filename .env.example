NODE_ENV=development
PORT=8098
APP_URL=http://localhost:8098
MONGODB_URI=mongodb://127.0.0.1:27028/?directConnection=true
MONGODB_DB=sandbee_admin
# Generate with npm run setup; keep outside backups and Git.
VAULT_KEY=
AUTH_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1031
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Sandbee Admin <admin@sandbee.in>
# Production: smtp.gmail.com, port 465, secure true, Gmail address + App Password.
# Optional isolated Store reader. Use a read-only DB account in production.
STORE_MONGODB_URI=
STORE_MONGODB_DB=sandbee_platform
TRUST_PROXY_HOPS=0
ECOM_SERVICE_URL=
ECOM_SERVICE_KEY=
# Client files in S3: set all four or none (a partial set stops the boot).
FILES_S3_REGION=ap-south-1
FILES_S3_BUCKET=
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=
# Optional. Admin backups are manual mongodumps; only the legacy snapshot tool uses this.
BACKUP_KEY=
